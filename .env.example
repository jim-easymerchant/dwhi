# Copy this file to `.env` and fill in your key.
# Without a key, the app falls back to the mock receipt parser.
#
# IMPORTANT: `EXPO_PUBLIC_*` values are inlined into the bundled JavaScript and
# are therefore visible to anyone who installs the APK. This is acceptable for
# local development but is NOT safe for a published build — in production you
# would move the OpenAI call behind a server proxy that holds the key.
EXPO_PUBLIC_OPENAI_API_KEY=

# Optional override. Defaults to gpt-4o-mini, which is vision-capable.
EXPO_PUBLIC_OPENAI_MODEL=
