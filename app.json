{
  "expo": {
    "name": "Do We Have It?",
    "slug": "do-we-have-it",
    "version": "0.1.0",
    "scheme": "dwhi",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "android": {
      "package": "com.dwhi.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dwhi.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos of items and receipts to remember what you have.",
        "NSPhotoLibraryUsageDescription": "Pick photos of items and receipts from your library."
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan product barcodes and take photos of items."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick photos of items and receipts from your library.",
          "cameraPermission": "Take photos of items and receipts to remember what you have."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "e3354b8c-30ee-425d-925d-36afa8cf0f8f"
      }
    },
    "owner": "jimrising"
  }
}
