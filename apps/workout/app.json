{
  "expo": {
    "name": "Momentum",
    "slug": "workout-rpg-momentum",
    "version": "0.1.0",
    "scheme": "momentum",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "android": {
      "package": "com.dwhi.workout",
