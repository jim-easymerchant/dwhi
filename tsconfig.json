{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@dwhi/framework": ["./packages/framework/src/index.ts"],
      "@dwhi/framework/*": ["./packages/framework/src/*"],
      "@dwhi/ui": ["./packages/ui/src/index.ts"],
      "@dwhi/ui/*": ["./packages/ui/src/*"],
      "@dwhi/domain": ["./packages/domain/src/index.ts"],
      "@dwhi/domain/*": ["./packages/domain/src/*"],
      "@dwhi/workout-domain": ["./packages/workout-domain/src/index.ts"],
      "@dwhi/workout-domain/*": ["./packages/workout-domain/src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx"
  ]
}
